# ============================================================
#  .env.example — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
#  Ne jamais committer .env dans Git
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=devfeed
POSTGRES_PASSWORD=change_me

# ── Redis ────────────────────────────────────────────────────
# Laisser vide pour désactiver l'authentification en local
REDIS_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 64
JWT_SECRET=change_me_with_a_very_long_random_secret
JWT_EXPIRATION_MS=86400000   # 24 heures

# ── PgAdmin (dev uniquement) ─────────────────────────────────
PGADMIN_EMAIL=admin@devfeed.local
PGADMIN_PASSWORD=change_me

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me

# ── GitHub Container Registry (prod uniquement) ──────────────
GITHUB_USERNAME=your_github_username
IMAGE_TAG=latest
